{
    "name": "train-delay-map",
    "version": "1.0.0",
    "description": "Live map of delayed trains in Sweden.",
    "private": true,
    "scripts": {
        "test": "npm run eslint && npm run stylelint && npm run htmlhint",
        "start": "live-server --port=8080 --watch=.",
        "sass:watch": "sass --watch src/style/style.scss:src/style/style.css",
        "eslint": "eslint",
        "eslint:fix": "eslint --fix",
        "stylelint": "stylelint \"**/*.{css,scss}\"",
        "stylelint:fix": "stylelint --fix \"**/*.{css,scss}\"",
        "htmlhint": "htmlhint \"**/*.html\"",
        "format": "prettier --write \"src/**/*.{js,css,scss,html}\" \"*.html\""
    },
    "keywords": [
        "leaflet",
        "socket.io",
        "web-components",
        "trains"
    ],
    "author": "Teodor Lien",
    "license": "CC0-1.0",
    "devDependencies": {
        "@eslint/js": "^9.18.0",
        "eslint": "^9.25.1",
        "globals": "^15.14.0",
        "htmlhint": "^1.1.4",
        "live-server": "^1.2.2",
        "postcss": "^8.5.3",
        "prettier": "^3.9.10",
        "sass": "^1.106.1",
        "stylelint": "^16.19.1",
        "stylelint-config-sass-guidelines": "^12.1.0",
        "stylelint-config-standard": "^37.0.0"
    }
}
